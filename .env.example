# Where SQLite, raw uploads and config exports live.
# Local dev: ./data   Container: /data (bind-mounted from the Proxmox host)
COSTS_DATA_DIR=./data

# Required. 32 random bytes, base64. Encrypts source credentials at rest.
#   openssl rand -base64 32
COSTS_ENCRYPTION_KEY=

# Nightly sync time (local, 24h). Set to "off" to disable the scheduler.
COSTS_SYNC_AT=04:15
COSTS_TZ=America/Los_Angeles

# Optional: LLM fallback for uncategorised line items. Left unset, the
# attribution engine is purely deterministic and unmatched rows land in
# the __unallocated__ project for you to triage in the review queue.
ANTHROPIC_API_KEY=
